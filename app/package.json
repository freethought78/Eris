{
  "name": "eris",
  "productName": "Eris",
  "version": "0.1.1",
  "description": "Eris: self-hosted voice, chat and low-latency game streaming",
  "main": "main/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "vite build && electron . --no-sandbox",
    "dist:win": "vite build && electron-builder --win nsis --x64",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "electron": "44.11.1",
    "electron-builder": "26.18.1",
    "svelte": "5.57.3",
    "vite": "8.3.8"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "author": "Alex Brough",
  "repository": {
    "type": "git",
    "url": "https://github.com/freethought78/Eris"
  },
  "build": {
    "appId": "net.eris.app",
    "productName": "Eris",
    "directories": {
      "output": "out"
    },
    "files": [
      "main/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../helper/dist/windows",
          "to": "helper",
          "filter": [
            "ptrecv.exe",
            "*.dll",
            "FFMPEG-LICENSE.txt"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Eris-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "Eris-${version}.${ext}",
      "extraResources": [
        {
          "from": "../helper/bin",
          "to": "helper",
          "filter": [
            "ptsend",
            "ptrecv"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "freethought78",
        "repo": "Eris"
      }
    ]
  }
}
